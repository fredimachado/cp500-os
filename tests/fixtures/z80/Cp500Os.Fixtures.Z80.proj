    <Z80Program Include="syscalltest.asm" OutputName="syscalltest-0100.bin" Defines="ORIGIN=0x0100" />
    <Z80Program Include="devtest.asm" OutputName="devtest-0000.bin" Defines="ORIGIN=0x0000" />
    <Z80Program Include="devtest.asm" OutputName="devtest-0100.bin" Defines="ORIGIN=0x0100" />
