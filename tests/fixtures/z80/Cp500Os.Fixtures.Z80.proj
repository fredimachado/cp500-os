<Project Sdk="Microsoft.Build.NoTargets">
  <Import Project="$(RepoRoot)eng/Z80.targets" />

  <ItemGroup>
    <Z80Program Include="hello-boot.asm" />
    <Z80Program Include="reloc-sample.asm" OutputName="reloc-sample-0000.bin" Defines="ORIGIN=0x0000" />
    <Z80Program Include="reloc-sample.asm" OutputName="reloc-sample-0100.bin" Defines="ORIGIN=0x0100" />
    <Z80Program Include="reloc-sample.asm" OutputName="reloc-sample-6200.bin" Defines="ORIGIN=0x6200" />
    <Z80Program Include="spin.asm" OutputName="spin-0000.bin" Defines="ORIGIN=0x0000" />
    <Z80Program Include="spin.asm" OutputName="spin-0100.bin" Defines="ORIGIN=0x0100" />
    <Z80Program Include="statloop.asm" OutputName="statloop-0000.bin" Defines="ORIGIN=0x0000" />
    <Z80Program Include="statloop.asm" OutputName="statloop-0100.bin" Defines="ORIGIN=0x0100" />
    <Z80Program Include="rawkey.asm" OutputName="rawkey-0000.bin" Defines="ORIGIN=0x0000" />
    <Z80Program Include="rawkey.asm" OutputName="rawkey-0100.bin" Defines="ORIGIN=0x0100" />
  </ItemGroup>
</Project>
