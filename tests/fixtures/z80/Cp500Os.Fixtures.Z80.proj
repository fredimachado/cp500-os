    <Z80Program Include="serkid.asm" OutputName="serkid-0100.bin" Defines="ORIGIN=0x0100" />
    <Z80Program Include="hdtest.asm" OutputName="hdtest-0000.bin" Defines="ORIGIN=0x0000" />
    <Z80Program Include="hdtest.asm" OutputName="hdtest-0100.bin" Defines="ORIGIN=0x0100" />
    <Z80Program Include="nettest.asm" OutputName="nettest-0000.bin" Defines="ORIGIN=0x0000" />
    <Z80Program Include="nettest.asm" OutputName="nettest-0100.bin" Defines="ORIGIN=0x0100" />
