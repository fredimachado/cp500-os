<Project Sdk="Microsoft.Build.NoTargets">
  <Import Project="$(RepoRoot)eng/Z80.targets" />

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)tools/Cp500Os.MkReloc.Cli/Cp500Os.MkReloc.Cli.csproj" />
    <ProjectReference Include="$(RepoRoot)tests/fixtures/z80/Cp500Os.Fixtures.Z80.proj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Z80Program Include="sh.asm" OutputName="sh-0000.bin" Defines="ORIGIN=0x0000" />
    <Z80Program Include="sh.asm" OutputName="sh-0100.bin" Defines="ORIGIN=0x0100" />
    <Z80Program Include="hi.asm" OutputName="hi-0000.bin" Defines="ORIGIN=0x0000" />
    <Z80Program Include="hi.asm" OutputName="hi-0100.bin" Defines="ORIGIN=0x0100" />
    <Z80Program Include="ls.asm" OutputName="ls-0000.bin" Defines="ORIGIN=0x0000" />
    <Z80Program Include="ls.asm" OutputName="ls-0100.bin" Defines="ORIGIN=0x0100" />
    <Z80Program Include="cat.asm" OutputName="cat-0000.bin" Defines="ORIGIN=0x0000" />
    <Z80Program Include="cat.asm" OutputName="cat-0100.bin" Defines="ORIGIN=0x0100" />
    <Z80Program Include="cp.asm" OutputName="cp-0000.bin" Defines="ORIGIN=0x0000" />
    <Z80Program Include="cp.asm" OutputName="cp-0100.bin" Defines="ORIGIN=0x0100" />
    <Z80Program Include="mkdir.asm" OutputName="mkdir-0000.bin" Defines="ORIGIN=0x0000" />
    <Z80Program Include="mkdir.asm" OutputName="mkdir-0100.bin" Defines="ORIGIN=0x0100" />
    <Z80Program Include="rm.asm" OutputName="rm-0000.bin" Defines="ORIGIN=0x0000" />
    <Z80Program Include="rm.asm" OutputName="rm-0100.bin" Defines="ORIGIN=0x0100" />
    <Z80Program Include="mv.asm" OutputName="mv-0000.bin" Defines="ORIGIN=0x0000" />
    <Z80Program Include="mv.asm" OutputName="mv-0100.bin" Defines="ORIGIN=0x0100" />
    <Z80Program Include="more.asm" OutputName="more-0000.bin" Defines="ORIGIN=0x0000" />
    <Z80Program Include="more.asm" OutputName="more-0100.bin" Defines="ORIGIN=0x0100" />
    <Z80Program Include="date.asm" OutputName="date-0000.bin" Defines="ORIGIN=0x0000" />
    <Z80Program Include="date.asm" OutputName="date-0100.bin" Defines="ORIGIN=0x0100" />
    <Z80Program Include="ed.asm" OutputName="ed-0000.bin" Defines="ORIGIN=0x0000" />
    <Z80Program Include="ed.asm" OutputName="ed-0100.bin" Defines="ORIGIN=0x0100" />
    <Z80Program Include="term.asm" OutputName="term-0000.bin" Defines="ORIGIN=0x0000" />
    <Z80Program Include="term.asm" OutputName="term-0100.bin" Defines="ORIGIN=0x0100" />
  </ItemGroup>

  <PropertyGroup>
    <MkRelocDll>$(RepoRoot)build/artifacts/bin/Cp500Os.MkReloc.Cli/$([System.String]::Copy('$(Configuration)').ToLowerInvariant())/mkreloc.dll</MkRelocDll>
    <Shell0000>$(Z80OutputPath)sh-0000.bin</Shell0000>
    <Shell0100>$(Z80OutputPath)sh-0100.bin</Shell0100>
    <Hi0000>$(Z80OutputPath)hi-0000.bin</Hi0000>
    <Hi0100>$(Z80OutputPath)hi-0100.bin</Hi0100>
    <Reloc0000>$(Z80OutputPath)reloc-sample-0000.bin</Reloc0000>
    <Reloc0100>$(Z80OutputPath)reloc-sample-0100.bin</Reloc0100>
    <ShellC5x>$(Z80OutputPath)sh.c5x</ShellC5x>
    <HiC5x>$(Z80OutputPath)hi.c5x</HiC5x>
    <RelocC5x>$(Z80OutputPath)reloc.c5x</RelocC5x>
  </PropertyGroup>

  <Target Name="PackC5x" AfterTargets="AssembleZ80"
          Inputs="$(Shell0000);$(Shell0100);$(Hi0000);$(Hi0100);$(Reloc0000);$(Reloc0100);$(MkRelocDll);$(Z80OutputPath)ls-0000.bin;$(Z80OutputPath)cat-0000.bin;$(Z80OutputPath)cp-0000.bin;$(Z80OutputPath)mkdir-0000.bin;$(Z80OutputPath)rm-0000.bin;$(Z80OutputPath)mv-0000.bin;$(Z80OutputPath)more-0000.bin;$(Z80OutputPath)date-0000.bin;$(Z80OutputPath)ed-0000.bin;$(Z80OutputPath)spin-0000.bin;$(Z80OutputPath)spin-0100.bin;$(Z80OutputPath)statloop-0000.bin;$(Z80OutputPath)statloop-0100.bin;$(Z80OutputPath)rawkey-0000.bin;$(Z80OutputPath)rawkey-0100.bin;$(Z80OutputPath)term-0000.bin;$(Z80OutputPath)term-0100.bin;$(Z80OutputPath)sertest-0000.bin;$(Z80OutputPath)sertest-0100.bin;$(Z80OutputPath)polltest-0000.bin;$(Z80OutputPath)polltest-0100.bin;$(Z80OutputPath)serboard-0000.bin;$(Z80OutputPath)serboard-0100.bin;$(Z80OutputPath)serkid-0000.bin;$(Z80OutputPath)serkid-0100.bin"
          Outputs="$(ShellC5x);$(HiC5x);$(RelocC5x);$(Z80OutputPath)ls.c5x;$(Z80OutputPath)cat.c5x;$(Z80OutputPath)cp.c5x;$(Z80OutputPath)mkdir.c5x;$(Z80OutputPath)rm.c5x;$(Z80OutputPath)mv.c5x;$(Z80OutputPath)more.c5x;$(Z80OutputPath)date.c5x;$(Z80OutputPath)ed.c5x;$(Z80OutputPath)spin.c5x;$(Z80OutputPath)statloop.c5x;$(Z80OutputPath)rawkey.c5x;$(Z80OutputPath)term.c5x;$(Z80OutputPath)sertest.c5x;$(Z80OutputPath)polltest.c5x;$(Z80OutputPath)serboard.c5x;$(Z80OutputPath)serkid.c5x">
    <Error Condition="!Exists('$(MkRelocDll)')" Text="mkreloc was not built at $(MkRelocDll)." />
    <Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; exec &quot;$(MkRelocDll)&quot; &quot;$(Shell0000)&quot; &quot;$(Shell0100)&quot; -o &quot;$(ShellC5x)&quot; --bss 320 --stack 256 --entry 0" />
    <Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; exec &quot;$(MkRelocDll)&quot; &quot;$(Hi0000)&quot; &quot;$(Hi0100)&quot; -o &quot;$(HiC5x)&quot; --bss 0 --stack 256 --entry 0" />
    <Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; exec &quot;$(MkRelocDll)&quot; &quot;$(Reloc0000)&quot; &quot;$(Reloc0100)&quot; -o &quot;$(RelocC5x)&quot; --bss 0 --stack 256 --entry 0" />
    <Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; exec &quot;$(MkRelocDll)&quot; &quot;$(Z80OutputPath)ls-0000.bin&quot; &quot;$(Z80OutputPath)ls-0100.bin&quot; -o &quot;$(Z80OutputPath)ls.c5x&quot; --bss 1024 --stack 256 --entry 0" />
    <Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; exec &quot;$(MkRelocDll)&quot; &quot;$(Z80OutputPath)cat-0000.bin&quot; &quot;$(Z80OutputPath)cat-0100.bin&quot; -o &quot;$(Z80OutputPath)cat.c5x&quot; --bss 256 --stack 256 --entry 0" />
    <Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; exec &quot;$(MkRelocDll)&quot; &quot;$(Z80OutputPath)cp-0000.bin&quot; &quot;$(Z80OutputPath)cp-0100.bin&quot; -o &quot;$(Z80OutputPath)cp.c5x&quot; --bss 256 --stack 256 --entry 0" />
    <Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; exec &quot;$(MkRelocDll)&quot; &quot;$(Z80OutputPath)mkdir-0000.bin&quot; &quot;$(Z80OutputPath)mkdir-0100.bin&quot; -o &quot;$(Z80OutputPath)mkdir.c5x&quot; --bss 0 --stack 256 --entry 0" />
    <Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; exec &quot;$(MkRelocDll)&quot; &quot;$(Z80OutputPath)rm-0000.bin&quot; &quot;$(Z80OutputPath)rm-0100.bin&quot; -o &quot;$(Z80OutputPath)rm.c5x&quot; --bss 0 --stack 256 --entry 0" />
    <Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; exec &quot;$(MkRelocDll)&quot; &quot;$(Z80OutputPath)mv-0000.bin&quot; &quot;$(Z80OutputPath)mv-0100.bin&quot; -o &quot;$(Z80OutputPath)mv.c5x&quot; --bss 0 --stack 256 --entry 0" />
    <Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; exec &quot;$(MkRelocDll)&quot; &quot;$(Z80OutputPath)more-0000.bin&quot; &quot;$(Z80OutputPath)more-0100.bin&quot; -o &quot;$(Z80OutputPath)more.c5x&quot; --bss 0 --stack 256 --entry 0" />
    <Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; exec &quot;$(MkRelocDll)&quot; &quot;$(Z80OutputPath)date-0000.bin&quot; &quot;$(Z80OutputPath)date-0100.bin&quot; -o &quot;$(Z80OutputPath)date.c5x&quot; --bss 0 --stack 256 --entry 0" />
    <Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; exec &quot;$(MkRelocDll)&quot; &quot;$(Z80OutputPath)ed-0000.bin&quot; &quot;$(Z80OutputPath)ed-0100.bin&quot; -o &quot;$(Z80OutputPath)ed.c5x&quot; --bss 512 --stack 256 --entry 0" />
    <Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; exec &quot;$(MkRelocDll)&quot; &quot;$(Z80OutputPath)spin-0000.bin&quot; &quot;$(Z80OutputPath)spin-0100.bin&quot; -o &quot;$(Z80OutputPath)spin.c5x&quot; --bss 0 --stack 256 --entry 0" />
    <Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; exec &quot;$(MkRelocDll)&quot; &quot;$(Z80OutputPath)statloop-0000.bin&quot; &quot;$(Z80OutputPath)statloop-0100.bin&quot; -o &quot;$(Z80OutputPath)statloop.c5x&quot; --bss 0 --stack 256 --entry 0" />
    <Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; exec &quot;$(MkRelocDll)&quot; &quot;$(Z80OutputPath)rawkey-0000.bin&quot; &quot;$(Z80OutputPath)rawkey-0100.bin&quot; -o &quot;$(Z80OutputPath)rawkey.c5x&quot; --bss 0 --stack 256 --entry 0" />
    <Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; exec &quot;$(MkRelocDll)&quot; &quot;$(Z80OutputPath)term-0000.bin&quot; &quot;$(Z80OutputPath)term-0100.bin&quot; -o &quot;$(Z80OutputPath)term.c5x&quot; --bss 256 --stack 256 --entry 0" />
    <Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; exec &quot;$(MkRelocDll)&quot; &quot;$(Z80OutputPath)sertest-0000.bin&quot; &quot;$(Z80OutputPath)sertest-0100.bin&quot; -o &quot;$(Z80OutputPath)sertest.c5x&quot; --bss 64 --stack 256 --entry 0" />
    <Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; exec &quot;$(MkRelocDll)&quot; &quot;$(Z80OutputPath)polltest-0000.bin&quot; &quot;$(Z80OutputPath)polltest-0100.bin&quot; -o &quot;$(Z80OutputPath)polltest.c5x&quot; --bss 64 --stack 256 --entry 0" />
    <Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; exec &quot;$(MkRelocDll)&quot; &quot;$(Z80OutputPath)serboard-0000.bin&quot; &quot;$(Z80OutputPath)serboard-0100.bin&quot; -o &quot;$(Z80OutputPath)serboard.c5x&quot; --bss 128 --stack 256 --entry 0" />
    <Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; exec &quot;$(MkRelocDll)&quot; &quot;$(Z80OutputPath)serkid-0000.bin&quot; &quot;$(Z80OutputPath)serkid-0100.bin&quot; -o &quot;$(Z80OutputPath)serkid.c5x&quot; --bss 0 --stack 256 --entry 0" />
  </Target>
</Project>
